{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/core": "^4.4.8",
        "doctrine/doctrine-bundle": "^3.4.1",
        "doctrine/doctrine-migrations-bundle": "^4.0.1",
        "doctrine/orm": "^3.8",
        "gesdinet/jwt-refresh-token-bundle": "^2.3",
        "lexik/jwt-authentication-bundle": "^3.2",
        "nelmio/cors-bundle": "^2.6",
        "predis/predis": "^3.7.1",
        "symfony/asset": "8.1.*",
        "symfony/cache": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "8.1.*",
        "symfony/mailer": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/extra-bundle": "^2.12|^3.29",
        "twig/twig": "^2.12|^3.30",
        "vich/uploader-bundle": "^2.10.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "ci": [
            "@composer validate --no-check-publish",
            "@composer audit --no-interaction --abandoned=report",
            "@php bin/console doctrine:schema:validate --skip-sync",
            "@php bin/console cache:warmup --env=dev",
            "@php vendor/bin/phpstan analyse --no-progress --memory-limit=1G"
        ],
        "test": [
            "@php bin/console doctrine:database:drop --env=test --force --if-exists",
            "@php bin/console doctrine:database:create --env=test",
            "@php bin/console doctrine:migrations:migrate --env=test --no-interaction",
            "@php bin/console lexik:jwt:generate-keypair --env=test --skip-if-exists",
            "@php bin/phpunit"
        ]
    },
    "scripts-descriptions": {
        "ci": "Vérifications lancées par la CI sur chaque PR (voir .github/workflows/ci.yml)",
        "test": "Recrée la base de test et lance les tests PHPUnit (voir .github/workflows/ci.yml)"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.8",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*",
        "zenstruck/foundry": "^2.16"
    }
}
