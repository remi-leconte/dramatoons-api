APP_ENV=dev
APP_SECRET=!ChangeMe!
DEFAULT_URI=http://localhost:8081
FRONTEND_URL=http://localhost:5173
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Correspond aux valeurs par défaut de MariaDB dans compose.yaml ; en recette et en prod, compose.prod.yaml la construit à partir des variables MARIADB_*
DATABASE_URL="mysql://dramatoons:!ChangeMe!@mariadb:3306/dramatoons?serverVersion=12.3.2-MariaDB&charset=utf8mb4"
REDIS_URL=redis://redis:6379
MAILER_DSN=null://null

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=!ChangeMe!

# Lues par app:create-admin et app:create-deleted-user
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
DELETED_USER_PASSWORD=
